<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Calculadora IMC">

    <VerticalStackLayout
        Padding="24"
        Spacing="24">

        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">

                <Label
                    Text="Proporcione el peso en kilogramos:"/>
                <Entry
                    x:Name="pesoEntry"
                    BackgroundColor="WhiteSmoke"
                    Keyboard="Numeric"/>

                <Label
                    Text="Proporcione la estatura en metros:"/>
                <Entry
                    x:Name="estaturaEntry"
                    BackgroundColor="WhiteSmoke"
                    Keyboard="Numeric"/>

            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">

            <Button
                Text="Calcular"
                BackgroundColor="Green"
                TextColor="White"
                Clicked="OnCalcularButtonClicked"/>

            <Button
                Text="Limpiar"
                Clicked="OnLimpiarButtonClicked"/>

        </HorizontalStackLayout>

        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">

                <Label
                    Text="El índice de masa corporal de la persona es:"/>
                <Label
                    x:Name="imcLabel"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>

                <Label
                    Text="El estado nutricional de la persona es:"/>
                <Label
                    x:Name="EstadoNutricional"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>